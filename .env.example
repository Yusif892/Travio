# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/travio

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
